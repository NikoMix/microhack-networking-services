# Azure AI Foundry backend (keyless) — copy to .env and fill in. NEVER commit .env.
# Auth is via DefaultAzureCredential (az login / Managed Identity / GitHub OIDC).
# Do NOT add an API key here — keyless only.
AZURE_AI_FOUNDRY_PROJECT_ENDPOINT=https://<project>.services.ai.azure.com/api/projects/<project>
AZURE_AI_FOUNDRY_DEPLOYMENT=gpt-4o
# Use the latest GA API version.
OPENAI_API_VERSION=2024-10-21
# Optional explicit identity selection:
# AZURE_TENANT_ID=
# AZURE_SUBSCRIPTION_ID=
# Required RBAC on the Foundry project: "Azure AI Developer" (or "Cognitive Services OpenAI User").
