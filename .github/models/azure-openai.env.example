# Azure OpenAI backend (keyless) — copy to .env and fill in. NEVER commit .env.
# Auth is via DefaultAzureCredential (az login / Managed Identity / GitHub OIDC).
# Do NOT add an API key here — keyless only.
AZURE_OPENAI_ENDPOINT=https://<your-aoai>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
# Use the latest GA API version.
OPENAI_API_VERSION=2024-10-21
# Optional explicit identity selection for multi-sub/tenant setups:
# AZURE_TENANT_ID=
# AZURE_SUBSCRIPTION_ID=
# Required RBAC on the resource: "Cognitive Services OpenAI User".
