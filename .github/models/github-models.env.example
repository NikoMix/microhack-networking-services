# GitHub Models backend (default) — copy to .env and fill in. NEVER commit .env.
# OpenAI-compatible endpoint; zero Azure dependency. Ideal in Codespaces.
GITHUB_MODELS_ENDPOINT=https://models.github.ai/inference
# Codespaces injects GITHUB_TOKEN automatically; locally use a PAT with `models: read`.
GITHUB_TOKEN=
# Any text/chat model from the GitHub Models catalog (no image generation needed).
MODEL_ID=openai/gpt-4o
