      <mxGeometry x="80" y="50" width="170" height="130" as="geometry"/>
    </mxCell>

    <!-- Firewall Policy detail -->
    <mxCell id="fwpol" value="Firewall Policy: cfs-hub-fwpol-swc&#xa;────────────────────────&#xa;[Net Rules P100] DNS UDP:53 → 168.63.129.16 ✅&#xa;[Net Rules P200] VPN BGP TCP:179 → GW ✅&#xa;[App Rules P300] FQDN: *.azure.com ✅&#xa;[App Rules P300] FQDN: *.ubuntu.com ✅&#xa;[App Rules P400] FQDN: *.malicious.* ❌ DENY&#xa;[Default] All else ❌ IMPLICIT DENY" style="text;html=1;align=left;fontSize=8;fontColor=#7F3F00;" vertex="1" parent="fw-box">
      <mxGeometry x="10" y="200" width="310" height="160" as="geometry"/>
    </mxCell>

    <!-- Spoke VMs -->
