    <!-- Traffic flow key at bottom -->
    <mxCell id="flow-key" value="Traffic Flow Key:  ① Internet egress: VM → UDR → Firewall → SNAT → Internet  |  ② Inbound from on-prem: VPN GW → Hub → FW policy → Spoke  |  ③ Note: App Gateway subnet is EXEMPT from UDR (Azure restriction) — AGW manages its own routing" style="rounded=1;fillColor=#F0F0FF;strokeColor=#9999CC;fontSize=8;fontColor=#333366;" vertex="1" parent="1">
