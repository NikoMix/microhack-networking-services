  style law fill:#0078D4,color:#FFFFFF,stroke:#004C8C
  style vm1 fill:#1a5e20,color:#FFFFFF,stroke:#0d3b10
  style vm2 fill:#1a5e20,color:#FFFFFF,stroke:#0d3b10
  style pe fill:#C00000,color:#FFFFFF,stroke:#7B0000
  style agw fill:#6b0099,color:#FFFFFF,stroke:#430060
  style hub fill:#FFF9E6,stroke:#D6B656
  style spoke fill:#DAE8FC,stroke:#0070C0
  style udr_subnet fill:#D5E8D4,stroke:#82B366
  style exempt fill:#F3E5FF,stroke:#9B59B6
