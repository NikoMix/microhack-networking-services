%%{init: {'theme': 'base', 'themeVariables': {'primaryColor': '#0070C0', 'primaryTextColor': '#FFFFFF', 'primaryBorderColor': '#004C8C', 'lineColor': '#0070C0', 'secondaryColor': '#FFF2CC', 'tertiaryColor': '#E6F3FF'}}}%%

flowchart TB
  subgraph internet["🌐 Internet (Global)"]
    users["👥 Global Users<br/>(EU / APAC / Americas)"]
  end

  subgraph onprem["🏢 On-Premises / Branch (CFS Stockholm)<br/>172.16.0.0/12"]
    dc["Data Centre<br/>(Stockholm)"]
    branch["Branch Offices"]
  end

  subgraph azure["☁️ Azure — Sweden Central (swedencentral)"]

    subgraph global_edge["🌍 Global Edge — rg-cfs-edge-swc"]
      afd["Azure Front Door Standard<br/>cfs-edge-afd-swc<br/>WAF: Prevention | OWASP 3.2<br/>Global anycast"]
    end

    subgraph hub["🔑 Hub VNet — cfs-hub-vnet-swc (10.0.0.0/16)<br/>rg-cfs-hub-swc"]
      fw["🔥 Azure Firewall Standard<br/>cfs-hub-fw-swc<br/>10.0.0.4 (private)<br/>Zones: 1,2,3 | Threat Intel ON<br/>AzureFirewallSubnet: 10.0.0.0/26"]
      bas["🛡️ Azure Bastion Standard<br/>cfs-hub-bas-swc<br/>Browser RDP/SSH<br/>AzureBastionSubnet: 10.0.1.0/26"]
      vpngw["🔗 VPN Gateway<br/>cfs-hub-vpng-swc<br/>IKEv2 | BGP ASN 65515<br/>GatewaySubnet: 10.0.2.0/27"]
      law["📊 Log Analytics WS<br/>cfs-hub-law-swc<br/>Retention: 90 days"]
      kv["🔐 Key Vault<br/>cfs-hub-kv-swc<br/>Purge-protect: ON"]
    end

    subgraph spoke["💼 Workload Spoke — cfs-app-vnet-swc (10.1.0.0/16)<br/>rg-cfs-spoke-swc"]

      subgraph agw_subnet["AppGatewaySubnet (10.1.2.0/24)"]
        agw["🛡️ App Gateway v2 + WAF<br/>cfs-app-agw-swc<br/>SKU: WAF_v2 | Zones: 1,2,3<br/>WAF: Prevention | OWASP 3.2<br/>TLS: 1.2 minimum"]
      end

      subgraph app_subnet["AppSubnet (10.1.0.0/24) — UDR: 0/0 → Firewall"]
        vm1["💻 cfs-app-vm-swc-001<br/>D2s_v5 | Zone 1<br/>NO PUBLIC IP<br/>Managed Identity"]
        vm2["💻 cfs-app-vm-swc-002<br/>D2s_v5 | Zone 2<br/>NO PUBLIC IP<br/>Managed Identity"]
        ilb["⚖️ Internal Load Balancer<br/>cfs-app-ilb-swc<br/>Standard | Frontend: 10.1.3.4"]
      end

      subgraph pe_subnet["PrivateEndpointSubnet (10.1.1.0/24)"]
        pe_kv["🔐 PE: Key Vault<br/>10.1.1.4"]
        pe_sa["📦 PE: Storage Account<br/>10.1.1.5"]
        pe_sql["🗄️ PE: Azure SQL<br/>10.1.1.6"]
      end

    end

  end

  %% Global delivery path
  users -->|"HTTPS:443"| afd
  afd -->|"HTTPS → Origin"| agw
  agw -->|"HTTP → ILB → VMs"| ilb
  ilb -->|"TCP balanced"| vm1
  ilb -->|"TCP balanced"| vm2

  %% Hybrid connectivity
  dc <-->|"IKEv2 VPN tunnel<br/>(ExpressRoute by design)"| vpngw
  branch <-->|"IKEv2 VPN"| vpngw
  vpngw <-->|"Hub routing"| fw

  %% VNet Peering
  hub <-->|"VNet Peering<br/>(GW Transit)"| spoke

  %% Egress via Firewall
  vm1 -->|"All egress via UDR"| fw
  vm2 -->|"All egress via UDR"| fw
  fw -->|"SNAT to public IP"| internet

  %% Private access to PaaS
  vm1 -->|"HTTPS private"| pe_kv
  vm1 -->|"HTTPS private"| pe_sa
  vm2 -->|"HTTPS private"| pe_sql

  %% Bastion admin
  bas -. "RDP/SSH (browser tunnel)" .-> vm1
  bas -. "RDP/SSH (browser tunnel)" .-> vm2

  %% Monitoring
  fw -->|"Diag logs"| law
  agw -->|"Diag logs"| law
  vpngw -->|"Diag logs"| law

