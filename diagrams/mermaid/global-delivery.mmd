flowchart LR
  subgraph users["🌍 Global Users"]
    eu["EU User<br/>(Stockholm)"]
    us["US User<br/>(New York)"]
    apac["APAC User<br/>(Singapore)"]
  end

  subgraph afd_layer["Global Edge (Azure Front Door Standard)"]
    afd["Azure Front Door<br/>cfs-edge-afd-swc<br/>Global Anycast PoP<br/>HTTPS only<br/>HTTP → HTTPS redirect"]
    afd_waf["WAF Policy<br/>Prevention mode<br/>Microsoft_DefaultRuleSet 2.1<br/>OWASP 3.2"]
  end

  subgraph agw_layer["App Gateway v2 + WAF (swedencentral)"]
    agw["App Gateway<br/>cfs-app-agw-swc<br/>WAF_v2 SKU | Zones 1,2,3<br/>WAF: Prevention mode<br/>TLS: 1.2 minimum"]
    agw_waf["WAF Policy<br/>OWASP 3.2<br/>Prevention mode"]
  end

  subgraph backend["Backend Compute (AppSubnet — No Public IPs)"]
    ilb["Internal Load Balancer<br/>cfs-app-ilb-swc<br/>Frontend: 10.1.3.4"]
    vm1["VM-001<br/>Zone 1"]
    vm2["VM-002<br/>Zone 2"]
    vm3["VM-003<br/>Zone 3"]
  end

  subgraph fw_layer["Egress Control"]
    fw["Azure Firewall<br/>All egress via UDR"]
  end

  %% Traffic path
  eu -->|"HTTPS:443"| afd
  us -->|"HTTPS:443"| afd
  apac -->|"HTTPS:443"| afd
  afd --- afd_waf
  afd -->|"HTTPS origin request"| agw
  agw --- agw_waf
  agw -->|"HTTP to ILB"| ilb
  ilb -->|"Load balanced"| vm1
  ilb -->|"Load balanced"| vm2
  ilb -->|"Load balanced"| vm3
  vm1 -->|"UDR egress"| fw
  vm2 -->|"UDR egress"| fw
  vm3 -->|"UDR egress"| fw

