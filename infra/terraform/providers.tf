terraform {
  required_version = ">= 1.9"

  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 4.78"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.7"
    }
    tls = {
      source  = "hashicorp/tls"
      version = "~> 4.1"
    }
  }
}

provider "azurerm" {
  features {}

  # CI uses Azure workload identity federation/OIDC through ARM_USE_OIDC and related ARM_* env vars.
  # No client secrets, shared keys, or credentials are stored in this configuration.
}
